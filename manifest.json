{
  "manifest_version": 3,
  "name": "Tab Number Hints",
  "version": "1.0.0",
  "description": "Hold Command on macOS or Ctrl on Windows/Linux to show Chrome's native tab-switch digits.",
  "permissions": ["storage"],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": ["http://*/*", "https://*/*", "file:///*"],
      "js": ["content.js"],
      "run_at": "document_start",
      "all_frames": true,
      "match_about_blank": true,
      "match_origin_as_fallback": true
    }
  ]
}
